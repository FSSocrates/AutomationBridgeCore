<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Callers must hold this permission to start the engine -->
    <permission
        android:name="com.fssocrates.abc.permission.START_ENGINE"
        android:protectionLevel="normal"
        android:label="Start ABC Engine" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ABC"
        android:usesCleartextTraffic="true">

        <service
            android:name=".ABCForegroundService"
            android:exported="true"
            android:permission="com.fssocrates.abc.permission.START_ENGINE"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".SolverActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ABC" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ABC">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
